        },
        "step-2": {
          "id": "step-2",
          "type": "question",
          "stepLabel": "Check Internet / WAN Light",
          "stepIndex": 2,
          "totalSteps": 4,
          "title": "Check whether the Internet/WAN light is green or red.",
          "images": ["wan-lights"],
          "options": [
            { "id": "green", "label": "Green light", "next": "step-3-cables" },
            { "id": "red", "label": "Red light", "next": "terminal-ticket" }
          ]
        },
        "step-3-cables": {
          "id": "step-3-cables",
          "type": "question",
          "stepLabel": "Check Cables",
          "stepIndex": 3,
          "totalSteps": 4,
          "title": "Check that all power, WAN, and LAN cables are connected properly.",
          "description": "Is the internet working now?",
          "images": ["check-cables"],
          "options": [
            { "id": "fixed", "label": "Yes", "next": "resolved" },
            { "id": "not-fixed", "label": "Still not working", "next": "step-3-recheck", "showChevron": true }
          ]
