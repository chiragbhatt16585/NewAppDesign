        "step-3-recheck": {
          "id": "step-3-recheck",
          "type": "question",
          "stepLabel": "Restart Router",
          "stepIndex": 4,
          "totalSteps": 4,
          "title": "Reboot your router and wait ~30 seconds.",
          "description": "Is the internet working now?",
          "images": ["restart-router-30secs"],
