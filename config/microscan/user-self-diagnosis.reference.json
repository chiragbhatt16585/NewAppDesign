            { "id": "fixed", "label": "Yes", "next": "resolved" },
            { "id": "not-fixed", "label": "Still not working", "next": "terminal-ticket-final", "showChevron": true }
          ]
        },
        "resolved": {
          "id": "resolved",
          "type": "result",
          "title": "Your issue has been resolved.",
          "action": "done"
        },
        "terminal-ticket": {
          "id": "terminal-ticket",
          "type": "terminal",
          "stepLabel": "Final Step",
          "stepIndex": 2,
          "totalSteps": 4,
          "title": "Your connection may require further assistance.",
          "showCompletedSteps": true,
          "allowDescription": true,
          "action": "raise_ticket"
        },
        "terminal-ticket-final": {
          "id": "terminal-ticket-final",
          "type": "terminal",
          "stepLabel": "Final Step",
          "stepIndex": 4,
          "totalSteps": 4,
          "title": "Your connection may require further assistance.",
          "showCompletedSteps": true,
          "allowDescription": true,
          "action": "raise_ticket"
        }
